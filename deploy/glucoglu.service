[Unit]
Description=Glucoglu web app
Wants=network.target
After=network.target postgresql.service

[Service]
Type=forking
User=glucoglu
Group=glucoglu
WorkingDirectory=/opt/glucoglu
EnvironmentFile=/etc/glucoglu.env
# hypnotoad lives in the perlbrew perl of the glucoglu user; adjust the version after install
ExecStart=/opt/glucoglu/perl5/perlbrew/perls/perl-5.40.0/bin/hypnotoad /opt/glucoglu/script/glucoglu
ExecReload=/opt/glucoglu/perl5/perlbrew/perls/perl-5.40.0/bin/hypnotoad /opt/glucoglu/script/glucoglu
PIDFile=/opt/glucoglu/hypnotoad.pid

[Install]
WantedBy=multi-user.target