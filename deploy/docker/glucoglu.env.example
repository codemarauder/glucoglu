# Copy to /etc/glucoglu/glucoglu.env on the host, fill in, then:
#   chown root:root /etc/glucoglu/glucoglu.env && chmod 600 /etc/glucoglu/glucoglu.env
# Format: one VAR=value per line, no quotes, no spaces around "=".

# Signs the session cookie. Generate: head -c 32 /dev/urandom | base64
GLUCOGLU_SECRET=

# PostgreSQL on the host, through the Docker bridge gateway (see docker-compose.yml).
GLUCOGLU_DB_DSN=postgresql://glucoglu:PASSWORD@172.31.250.1/glucoglu

# Public address (Apache, TLS). Used in login mails.
GLUCOGLU_URL=https://app.example.org

# SMTP relay for login mails. If the relay runs on the host itself, use 172.31.250.1
# and make it listen there: 127.0.0.1 is the container, not the host.
GLUCOGLU_SMTP_HOST=
GLUCOGLU_SMTP_PORT=587
GLUCOGLU_SMTP_USER=
GLUCOGLU_SMTP_PASS=
GLUCOGLU_SMTP_FROM=glucoglu@app.example.org

# Libre 1 sync: the account that receives the Juggluco mirror data. Empty = sync off.
GLUCOGLU_LIBRE1_EMAIL=

# 1 = run the Juggluco mirror receiver in the container (stop the host receiver first).
JUGGLUCO_RECEIVER=0
