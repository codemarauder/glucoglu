# Copy to .env next to docker-compose.yml, fill in, and protect it:
#   cp deploy/docker/env.example .env && chmod 600 .env
# .env is git-ignored and docker-ignored. Never commit real values.
# Format: one VAR=value per line, no quotes, no spaces around "=".
# Compose expands "$" in values: write "$$" for a literal "$" (for example in a password).

# --- For docker-compose.yml ---
# uid that owns the Juggluco folder on the host (ls -ln). The container user gets this uid.
GLUCOGLU_UID=1000
# Juggluco folder on the host: the static binary and users/<name>/ (one per person).
# A relative path starts at the folder of docker-compose.yml (for example ./Juggluco).
JUGGLUCO_HOST_DIR=/opt/juggluco
# 1 = receiver debug lines in `docker logs juggluco` (one line per packet). For tests only.
JUGGLUCO_DEBUG=0

# --- For the app ---

# Signs the session cookie. Generate: head -c 32 /dev/urandom | base64
GLUCOGLU_SECRET=

# PostgreSQL on the host, through the Docker bridge gateway (see docker-compose.yml).
GLUCOGLU_DB_DSN=postgresql://glucoglu:PASSWORD@172.31.250.1/glucoglu

# Public address (Apache, TLS). Used in login mails.
GLUCOGLU_URL=https://app.example.org

# SMTP relay for login mails. If the relay runs on the host itself, use 172.31.250.1
# and make it listen there: 127.0.0.1 is the container, not the host.
GLUCOGLU_SMTP_HOST=
GLUCOGLU_SMTP_PORT=587
GLUCOGLU_SMTP_USER=
GLUCOGLU_SMTP_PASS=
GLUCOGLU_SMTP_FROM=glucoglu@app.example.org

# Libre 1 users: one folder per person in $JUGGLUCO_HOST_DIR/users/<name>/, with a
# user.conf (EMAIL=...). Not here. See README, section Deploy, "Juggluco users".
