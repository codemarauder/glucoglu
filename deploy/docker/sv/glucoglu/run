#!/bin/sh
# Web app. Listens on all container addresses; compose publishes it on 127.0.0.1:3000 only.
# -p: trust X-Forwarded-* from the Apache front end (same as hypnotoad's proxy => 1).
exec 2>&1
cd /app || exit 1
exec chpst -u glucoglu perl script/glucoglu prefork \
  -m production -l 'http://*:3000' -w 2 -p -P /tmp/glucoglu.pid
