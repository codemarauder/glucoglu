# Libre 1 sync: one export + import, then wait 60 s. runit starts it again, so runs never overlap.
exec 2>&1
chpst -u glucoglu -e /etc/glucoglu/env \
  env PERL=/opt/glucoglu/perl5/perlbrew/perls/perl-5.40.0/bin/perl \
  /opt/glucoglu/script/libre1-sync
exec sleep 60
