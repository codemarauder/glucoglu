% layout 'default';
% title 'Settings';
% if (my $notice = flash 'notice') {
<p class="notice"><%= $notice %></p>
% }
<h2>Ingest</h2>
<p>Point Juggluco's REST upload at</p>
<p><code><%= url_for('/api/v1/entries')->to_abs %></code></p>
<p>Token: <code><%= $token %></code> <span class="hint">(<code>?token=</code>, <code>Authorization: Bearer</code>, or Nightscout V1 <code>api-secret</code>)</span></p>
<form method="post" action="/dashboard/token">
  <button class="link">Regenerate ingest token</button>
</form>
<p class="hint"><%= $count %> reading<%= $count == 1 ? '' : 's' %> stored.</p>
<h2>Account</h2>
<form method="post" action="/logout">
  <button class="link">Log out</button>
</form>
<p class="hint"><a href="<%= url_for('dashboard') %>">Back to dashboard</a></p>