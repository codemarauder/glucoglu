% layout 'default';
% stash wide => 1;
% title 'Dashboard';
% if (my $notice = flash 'notice') {
<p class="notice"><%= $notice %></p>
% }
<h2>Today <span class="hint">the 100 m race</span></h2>
% if ($dlt) {
% my $dd = sub { defined $_[0] ? sprintf('%+.0f', $_[0]) : '—' };
<p class="today-head">
  <span class="today-current"><%= $latest->{mg_dl} %> <span class="today-unit">mg/dL</span></span>
  <span class="today-glyph"><%== $dlt->{glyph} // '?' %></span>
  <span class="today-age">(<%= $dlt->{age} < 3600 ? int($dlt->{age}/60).' min' : sprintf('%.1f h', $dlt->{age}/3600) %> ago)</span>
</p>
<p class="today-deltas">
  <strong>Δ 1min</strong> <%== $dd->($dlt->{d1}) %> mg/dL | <strong>Δ 5mins </strong> <%== $dd->($dlt->{d5}) %> mg/dL | <strong>Δ 15mins</strong> <%== $dd->($dlt->{d15}) %> mg/dL
</p>
% } else {
<p>No readings today yet. Scan the sensor — data arrives with the next mirror sync.</p>
% }
% if ($m24->{n}) {
<p class="last24">
  <strong>Last 24 h:</strong>
  <span class="<%= $g24->{tir} %>">TIR: <%= sprintf('%.0f', $m24->{tir}) %>%</span> |
  <span class="<%= $g24->{tbr70} %>">&lt;70: <%= sprintf('%.0f', $m24->{tbr70}) %>%</span> |
  <span class="<%= $g24->{tbr54} %>">&lt;54: <%= sprintf('%.0f', $m24->{tbr54}) %>%</span> |
  <span class="<%= $g24->{tar180} %>">&gt;180: <%= sprintf('%.0f', $m24->{tar180}) %>%</span> |
  Mean: <%= sprintf('%.0f', $m24->{mean}) %> |
  Hypos: <%= $m24->{events}{l1} %> |
  Data: <%= sprintf('%.0f', $m24->{sufficiency}) %>%
  <span class="hint">Targets are for 14 days.</span>
</p>
% } else {
<p class="last24">Last 24 h: no data</p>
% }
<div class="graph">
% if ($today_svg) {
<%== $today_svg %>
% } else {
  <p>No readings for this day.</p>
% }
% if ($day < 90) {
  <a class="navbtn left" href="<%= url_for->query(day => $day + 1, days => $days, user_id => $target) %>" title="previous day">‹</a>
% } else {
  <span class="navbtn left off">‹</span>
% }
% if ($day > 0) {
  <a class="navbtn right" href="<%= url_for->query(day => $day - 1, days => $days, user_id => $target) %>" title="next day">›</a>
% } else {
  <span class="navbtn right off">›</span>
% }
</div>
<p class="daynav"><%= $day == 0 ? 'Today' : $day_label %></p>
% if ($today_svg) {
<p class="hint caption">Dots are NFC spot scans; green band = 70–180 target range; gaps = no data.</p>
% }

<h2>AGP <span class="hint">the marathon — percentiles by time of day</span></h2>
<p class="winnav">
% my $first = 1;
% for my $d (7, 14, 30, 90) {
%   if ($first) { $first = 0 } else {
 <span class="sep">|</span>
%   }
%   if ($d == $days) {
<strong><%= $d %>d</strong>
%   } else {
<a href="<%= url_for->query(days => $d, day => $day, user_id => $target) %>"><%= $d %>d</a>
%   }
% }
</p>
% if ($svg) {
<%== $svg %>
<p class="hint caption">Bands: 5–95% (light), 25–75% (dark), median line. Dashed guides at 70, 180, 250 mg/dL.</p>
% } else {
<p>No readings in the last <%= $days %> days.</p>
% }

% if ($m->{n}) {
<h2>Tier 1 <span class="hint"><%= $m->{n} %> readings, <%= sprintf('%.0f', $m->{sufficiency}) %>% data sufficiency</span></h2>
<table>
  <tr class="<%= $g->{tir} %>"><td>Time in range 70–180</td><td><strong><%= sprintf('%.1f', $m->{tir}) %>%</strong></td><td class="hint">target &gt; 70%</td></tr>
  <tr class="<%= $g->{tar180} %>"><td>Time above 180 / 250</td><td><%= sprintf('%.1f', $m->{tar180}) %>% / <%= sprintf('%.1f', $m->{tar250}) %>%</td><td class="hint">&lt; 25% / &lt; 5%</td></tr>
  <tr class="<%= $g->{tbr70} %>"><td>Time below 70 / 54</td><td><%= sprintf('%.1f', $m->{tbr70}) %>% / <%= sprintf('%.1f', $m->{tbr54}) %>%</td><td class="hint">&lt; 4% / &lt; 1%</td></tr>
  <tr><td>Mean glucose</td><td><%= sprintf('%.0f', $m->{mean}) %> mg/dL</td></tr>
  <tr class="<%= $g->{cv} %>"><td>SD / CV</td><td><%= sprintf('%.1f', $m->{sd}) %> / <%= sprintf('%.1f', $m->{cv}) %>%</td><td class="hint">CV ≤ 36%</td></tr>
  <tr><td>GMI</td><td><%= sprintf('%.1f', $m->{gmi}) %>%</td><td class="hint">eA1c (ADAG): <%= sprintf('%.1f', $m->{ea1c}) %>%</td></tr>
  <tr><td>Hypo events (L1 / L2)</td><td><%= $m->{events}{l1} %> / <%= $m->{events}{l2} %></td><td class="hint">≥15 min; extended &gt;120 min: <%= $m->{events}{ext_hypo} %></td></tr>
  <tr><td>Hyper events &gt;250</td><td><%= $m->{events}{hyper} %></td><td class="hint">extended ≥90 min: <%= $m->{events}{ext_hyper} %></td></tr>
</table>
<p class="hint caption">Row shading — green: at target, amber: partial, red: off-target (Battelino 2019, Table 2).</p>
% }

<p class="hint"><%= $count %> reading<%= $count == 1 ? '' : 's' %> stored · <a href="<%= url_for('settings') %>">Settings</a></p>
